<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Workstation GC, non-concurrent: written to runtimeconfig.json and honored by IIS in-process.
      Lowers memory use on small hosts. Cap the heap per environment with DOTNET_GCHeapHardLimit
      or runtimeconfig System.GC.HeapHardLimit; do not set a limit in this project.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xiangqi.Core\Xiangqi.Core.csproj" />
    <ProjectReference Include="..\Xiangqi.Engine\Xiangqi.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="NKaspa" Version="0.1.11-alpha" />
  </ItemGroup>

  <!--
    Build stamp for /api/health: short git SHA + UTC build time.
    SHA precedence: -p:SourceRevisionId=<sha> (CI/Docker) > `git rev-parse` in the repo > "unknown".
    The SDK folds SourceRevisionId into AssemblyInformationalVersion as "<version>+<sha>".
  -->
  <Target Name="StampBuildInfo" BeforeTargets="InitializeSourceControlInformation;GetAssemblyAttributes">
    <Exec Condition="'$(SourceRevisionId)' == ''" Command="git rev-parse --short=12 HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_StampGitSha" />
    </Exec>
    <PropertyGroup Condition="'$(SourceRevisionId)' == '' And '$(_StampGitSha)' != ''">
      <SourceRevisionId>$(_StampGitSha.Trim())</SourceRevisionId>
    </PropertyGroup>
    <PropertyGroup>
      <_StampBuiltAt Condition="'$(BuildTimeUtc)' == ''">$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</_StampBuiltAt>
      <_StampBuiltAt Condition="'$(BuildTimeUtc)' != ''">$(BuildTimeUtc)</_StampBuiltAt>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuiltAt</_Parameter1>
        <_Parameter2>$(_StampBuiltAt)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
